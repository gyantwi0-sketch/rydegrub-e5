# EXAMPLE ONLY. Never commit real keys, tokens, customer details, PNR or passwords.
# Copy to .env.local in development; use protected deploy secrets in production.
# All three API services must use the exact deployed HTTPS origin.
MEDIA_APP_ORIGIN=https://your-app.example
MEDIA_TOKEN_ISSUER=https://your-login-issuer.example
MEDIA_TOKEN_AUDIENCE=rydegrub-media
MEDIA_TOKEN_PUBLIC_KEY=REPLACE_WITH_VERIFICATION_PUBLIC_KEY_PEM
MEDIA_DATA_DIR=/srv/rydegrub/media

TRACKING_APP_ORIGIN=https://your-app.example
TRACKING_TOKEN_ISSUER=https://your-login-issuer.example
TRACKING_TOKEN_AUDIENCE=rydegrub-orders
TRACKING_TOKEN_PUBLIC_KEY=REPLACE_WITH_VERIFICATION_PUBLIC_KEY_PEM
TRACKING_DATA_DIR=/srv/rydegrub/tracking

PROFILE_APP_ORIGIN=https://your-app.example
PROFILE_TOKEN_ISSUER=https://your-login-issuer.example
PROFILE_TOKEN_AUDIENCE=rydegrub-profile
PROFILE_TOKEN_PUBLIC_KEY=REPLACE_WITH_VERIFICATION_PUBLIC_KEY_PEM
PROFILE_DATA_DIR=/srv/rydegrub/profile
PROFILE_OTP_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional until a production SMS provider is configured.
# PROFILE_SMS_URL=https://your-sms-provider.example/api/send
# PROFILE_SMS_KEY=REPLACE_WITH_PROVIDER_BEARER_CREDENTIAL

# Required when the admin-managed catalog is enabled.
# CATALOG_DATA_DIR=/srv/rydegrub/catalog
# CATALOG_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Required when the domain persistence store is enabled.
# DOMAIN_DATA_DIR=/srv/rydegrub/domain


# Native accounts: Node 24.7+, persistent private volume, HTTPS required.
# Omit legacy *_TOKEN_PUBLIC_KEY settings to use native verified sessions.
ACCOUNT_APP_ORIGIN=https://ryde.example
ACCOUNT_DATA_DIR=/srv/rydegrub/accounts
ACCOUNT_RATE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCOUNT_EMAIL_URL=https://email-adapter.example/transactional
ACCOUNT_EMAIL_KEY=REPLACE_WITH_EMAIL_ADAPTER_KEY
# Optional ONLY when an ingress overwrites and strips client copies:
# ACCOUNT_TRUSTED_IP_HEADER=x-trusted-client-ip
RATE_LIMIT_REDIS_URL=https://redis-rest.example
RATE_LIMIT_REDIS_TOKEN=REPLACE_WITH_REDIS_REST_TOKEN

# Shared admission limits for profile/media/tracking; ACCOUNT_RATE_SECRET is a fallback.
RATE_LIMIT_KEY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set ONLY for an ingress-controlled header, never a client supplied one:
# RATE_LIMIT_TRUSTED_IP_HEADER=x-trusted-client-ip
OPERATIONS_METRICS_TOKEN=REPLACE_WITH_PRIVATE_METRICS_SCRAPE_TOKEN


# Enables authenticated cart/quote/draft APIs with native ACCOUNT_* settings.
# Use a private persistent volume, outside public/ and .next/.
# DOMAIN_DATA_DIR=/srv/rydegrub/domain
